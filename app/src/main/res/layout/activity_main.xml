<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f4f7fc"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Profile Section -->
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutProfile"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgProfileAvatar"
                android:background="@drawable/circle_bg"
                android:padding="5dp"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/avatar_boy" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp">

                <TextView
                    android:textSize="14sp"
                    android:textColor="#888"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back," />

                <TextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#333"
                    android:id="@+id/txtProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#aaa"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Storage Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStorage"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333"
                        android:id="@+id/txtStorageTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Internal Storage"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="#888" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/storageProgress"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="12dp"
                    android:progress="0"
                    android:progressTint="#3f51b5"
                    style="?android:attr/progressBarStyleHorizontal" />

                <TextView
                    android:textSize="14sp"
                    android:id="@+id/txtStorageDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Calculating..." />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Send and Receive Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:weightSum="2">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnSend"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#4caf50"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="#fff" />

                    <TextView
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="SEND" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnReceive"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="#2196f3"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@android:drawable/stat_sys_download"
                        app:tint="#fff" />

                    <TextView
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#fff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="RECEIVE" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- History Button -->
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:gravity="center"
            android:id="@+id/btnHistory"
            android:background="?android:attr/selectableItemBackground"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Transfer History" />

    </LinearLayout>
</ScrollView>