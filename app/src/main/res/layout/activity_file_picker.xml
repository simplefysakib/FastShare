<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="horizontal"
            android:background="#3f51b5"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/tabApps"
                android:textColor="#fff"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="APPS"
                android:layout_weight="1" />

            <Button
                android:id="@+id/tabPhotos"
                android:textColor="#fff"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="PHOTOS"
                android:layout_weight="1" />

            <Button
                android:id="@+id/tabFiles"
                android:textColor="#fff"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="FILES"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#e8eaf6"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/editSearch"
                android:textColor="#333"
                android:background="@android:drawable/editbox_background"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:hint="Search files..."
                android:singleLine="true"
                android:drawablePadding="8dp"
                android:layout_weight="1"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:paddingStart="10dp" />

            <ImageView
                android:id="@+id/btnSort"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#3f51b5" xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/mediaListView"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:dividerHeight="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:elevation="10dp">

            <LinearLayout
                android:id="@+id/btnReviewCart"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="20dp">

                <ImageView
                    android:id="@+id/cartIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#3f51b5" xmlns:app="http://schemas.android.com/apk/res-auto" />

                <TextView
                    android:id="@+id/txtSelectedCount"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#3f51b5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected (0)"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSendSelected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="SEND"
                android:stateListAnimator="@null"
                android:backgroundTint="#4caf50" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>